# Copy to .env and fill in. docker compose reads it for every Checkcord service.

# --- Required ---------------------------------------------------------------

# production refuses to start without FERNET_MASTER_KEY or with an RLS-exempt database role.
ENVIRONMENT=production
# Tenant used by `checkcord` commands when --tenant is omitted; not a secret.
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
# Encrypts stored provider tokens: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_MASTER_KEY=
# Chat models, and embeddings when EMBEDDING_PROVIDER=openai.
OPENAI_API_KEY=
# Embeddings when EMBEDDING_PROVIDER=voyage (the default).
VOYAGE_API_KEY=
# Public URL of the API, printed in webhook setup by `checkcord connect`.
PUBLIC_BASE_URL=http://localhost:8000
# Where the web console is served; also the default CORS origin and sign-in return address.
WEB_BASE_URL=http://localhost:3000
# Host ports Compose publishes the API and console on. Change PUBLIC_BASE_URL, WEB_BASE_URL and
# CHECKCORD_API_URL to match when you change them. See docs/self-hosting.md#addresses-and-ports.
# CHECKCORD_API_PORT=8000
# CHECKCORD_WEB_PORT=3000
# Host ports of the bundled Postgres and Redis, on 127.0.0.1.
# CHECKCORD_POSTGRES_PORT=5432
# CHECKCORD_REDIS_PORT=6379
# Images Compose runs. Unset, it builds them here. To run a release instead, for example:
#   CHECKCORD_IMAGE=ghcr.io/mihirp381/checkcord:0.1.0
#   CHECKCORD_WEB_IMAGE=ghcr.io/mihirp381/checkcord/web:0.1.0
# CHECKCORD_IMAGE=checkcord:local
# CHECKCORD_WEB_IMAGE=checkcord-web:local
# Host address Compose publishes both on. Set 0.0.0.0 to reach them from other machines.
# CHECKCORD_BIND_ADDRESS=127.0.0.1
# Reverse proxies trusted for X-Forwarded-For, comma-separated; rate limits use the client address.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Database. Compose builds DATABASE_URL / MIGRATION_DATABASE_URL from these; generate each with: openssl rand -hex 24
# Superuser of the bundled Postgres container (used only to create the roles below).
POSTGRES_PASSWORD=
# checkcord_owner owns the schema and runs `checkcord migrate`.
CHECKCORD_OWNER_DB_PASSWORD=
# checkcord_app serves the API and worker; row-level security applies to it.
CHECKCORD_APP_DB_PASSWORD=
# Outside compose set the URLs directly; roles come from deploy/postgres/roles.sql.
# DATABASE_URL=postgresql+asyncpg://checkcord_app:PASSWORD@db.example.com:5432/checkcord
# MIGRATION_DATABASE_URL=postgresql+asyncpg://checkcord_owner:PASSWORD@db.example.com:5432/checkcord
# Development (`make dev-up`) may keep one role: leave both unset to use checkcord:checkcord@localhost.
# REDIS_URL=redis://localhost:6379/0

# --- Connectors (optional) --------------------------------------------------
# Every connector is set up with `checkcord connect`; Slack, Teams, Notion and Linear print a
# one-time install link. `checkcord secrets encrypt` encrypts any
# connector credentials still stored in plain text.

# Slack app OAuth credentials.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Slack request signing secret.
SLACK_SIGNING_SECRET=
# Slack OAuth redirect, e.g. https://checkcord.example.com/slack/oauth_redirect
SLACK_REDIRECT_URI=
# Slack Socket Mode app token (xapp-...), only for Socket Mode.
SLACK_APP_TOKEN=
# Bot scopes requested at install, comma-separated; `checkcord connect slack` prints the default set.
# SLACK_BOT_SCOPES=channels:history,groups:history,channels:read,groups:read,users:read,users:read.email,usergroups:read
# Microsoft Teams / Graph app; also used to fetch Teams meeting transcripts.
# MSTEAMS_CLIENT_ID is the bot's Microsoft App ID: /api/messages only accepts tokens issued for it.
MSTEAMS_CLIENT_ID=
MSTEAMS_CLIENT_SECRET=
MSTEAMS_REDIRECT_URI=
# Notion OAuth app.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=
# Linear OAuth app.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URI=
# Signs install links; derived from FERNET_MASTER_KEY when unset. Changing it voids open links.
# OAUTH_STATE_SECRET=
# API URL the console's browsers call; read when the web container starts.
# Compose uses http://localhost:CHECKCORD_API_PORT when unset.
# CHECKCORD_API_URL=https://checkcord.example.com

# --- Browser sign-in (optional) --------------------------------------------
# OpenID Connect; see docs/sign-in.md. Leave OIDC_ISSUER unset to use API keys only.
# People sign in to DEFAULT_TENANT_ID. The callback is PUBLIC_BASE_URL/api/v1/auth/callback.
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=
# OIDC_SCOPES=openid email profile
# Accept an email without email_verified (Entra ID sends none).
# OIDC_ALLOW_MISSING_EMAIL_VERIFIED=false
# Create unknown people from these email domains at first sign-in.
# OIDC_AUTO_CREATE_DOMAINS=example.com
# Make the admin flag follow a claim at each sign-in.
# OIDC_ADMIN_GROUPS_CLAIM=groups
# OIDC_ADMIN_GROUPS=checkcord-admins
# Or let SCIM groups decide admin rights. When set, sign-in does not change the admin flag.
# SCIM_ADMIN_GROUPS=Checkcord Admins
# SESSION_IDLE_MINUTES=60
# SESSION_MAX_HOURS=12
# Serve /docs and /openapi.json; off in production unless set.
# API_DOCS_ENABLED=false

# --- Tuning (defaults are fine) ---------------------------------------------

# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
# Also write each audit entry as a checkcord.audit log line; the table is written either way.
# AUDIT_LOG_LINES=true
# Extra CORS origins, comma-separated; defaults to WEB_BASE_URL.
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# OpenAI-compatible endpoint for chat models instead of api.openai.com. For models on this
# machine, start from .env.local-models.example instead.
# LLM_BASE_URL=
# Seconds one chat-model call may take; raise it for slow local models.
# LLM_TIMEOUT_SECONDS=60
# openai or voyage; changing it needs a re-embed (scripts/reembed_canonical_contexts.py).
# EMBEDDING_PROVIDER=voyage
# EMBEDDING_MODEL=voyage-code-3
# Width of the model's vectors; `checkcord migrate` sizes the database column to it.
# EMBEDDING_DIMENSION=1024
# OpenAI-compatible embeddings endpoint for EMBEDDING_PROVIDER=openai.
# EMBEDDING_BASE_URL=
# Ask an OpenAI-style endpoint for EMBEDDING_DIMENSION-wide vectors; unset, only text-embedding-3 models are asked.
# EMBEDDING_SEND_DIMENSIONS=
# Rerank retrieved contexts with Voyage.
# RERANK_ENABLED=false
# Run the model pass when a record summary is stored; the regex pass always runs. Reads never call a model.
# REDACTION_MODEL_PASS=true
# Records whose model pass failed that each worker sweep retries.
# REDACTION_SWEEP_BATCH_SIZE=50
# Price per million input and output tokens by model, as JSON; enables cost estimates in `checkcord usage`.
# MODEL_PRICES={"gpt-4o-mini": [0.15, 0.6]}
# Pull-request check: judge (a model reads the diff against each record) or touch (no model call).
# PR_CHECK_MODE=judge
# PR_CHECK_MODEL=gpt-4o-mini
# Chat models: assigning messages to discussions, and extracting what a discussion settled.
# CHAT_ROUTER_MODEL=gpt-4o-mini
# CHAT_EXTRACTION_MODEL=gpt-4o
# Top-level messages per channel buffer, and the longest it waits, before assignment.
# CHAT_BUFFER_MAX_MESSAGES=5
# CHAT_BUFFER_TIMEOUT_SECONDS=180
# Seconds a discussion must be quiet before what it settled is extracted.
# CHAT_DISCUSSION_IDLE_SECONDS=1800
# Seconds between worker sweeps: retry unfinished events, trim acknowledged stream entries.
# WORKER_SWEEP_INTERVAL_SECONDS=60
# Minutes between confidence aggregation sweeps.
# CONFIDENCE_AGGREGATOR_INTERVAL_MINUTES=60
# Minutes between judge batch sweeps.
# JUDGE_BATCH_SWEEP_INTERVAL_MINUTES=30
# Minutes between Jira/Notion/Linear document polls.
# TASK_DOCUMENT_POLL_INTERVAL_MINUTES=15
# Minutes between re-reads of each Slack channel, Teams conversation and GitHub repository audience.
# AUDIENCE_REFRESH_INTERVAL_MINUTES=60
# Hours a last known audience is kept when the provider cannot be read; then it is emptied.
# AUDIENCE_REFRESH_GRACE_HOURS=24
# Events changed per transaction when a refresh touches a large channel or repository.
# AUDIENCE_REFRESH_BATCH_SIZE=500

# --- Monitoring and limits ----------------------------------------------------
# Prometheus metrics at /metrics on the API and the worker (port 9100); set a token with them.
# METRICS_ENABLED=false
# METRICS_TOKEN=
# Worker health and metrics port; 0 turns it off. Compose sets WORKER_HTTP_HOST=0.0.0.0.
# WORKER_HTTP_PORT=9100
# Per-minute limits, answered with 429 and Retry-After. Counted in Redis.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS_PER_MINUTE=600
# RATE_LIMIT_AUTH_FAILURES_PER_MINUTE=30
# RATE_LIMIT_SIGN_IN_PER_MINUTE=30
# RATE_LIMIT_WEBHOOKS_PER_MINUTE=1200

# --- Retention ----------------------------------------------------------------
# Days to keep events, from when they happened; a daily job deletes older ones. Unset keeps them.
# EVENT_RETENTION_DAYS=
# Days to keep audit entries; `checkcord audit prune` deletes older ones. Unset keeps them.
# AUDIT_RETENTION_DAYS=

# --- Review -------------------------------------------------------------------
# Start every new connection in review; its material is held until `checkcord review release`.
# REVIEW_NEW_CONNECTIONS=false

# --- Developer machine (`checkcord mcp`) -----------------------------------------
# Set both to forward MCP tool calls to the API's /mcp; no database URL is needed then.
# CHECKCORD_PROXY_API_URL=https://checkcord.example.com
# Personal key from `checkcord keys create --user EMAIL`; sent as the Bearer token.
# CHECKCORD_PROXY_API_KEY=
