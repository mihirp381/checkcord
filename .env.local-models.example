# Try Checkcord with models on your own machine: cp .env.local-models.example .env
# Needs Ollama (or any OpenAI-compatible server) on the host with these models pulled:
#   ollama pull qwen2.5-coder:7b && ollama pull mxbai-embed-large
# Nothing leaves the machine. For a trial only: development mode uses built-in
# database passwords and encryption key. Use .env.example for anything real.

ENVIRONMENT=development
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# The containers reach the host as host.docker.internal (Compose maps it on Linux too).
# On Linux, Ollama must listen beyond 127.0.0.1: set OLLAMA_HOST=0.0.0.0 for its service.
LLM_BASE_URL=http://host.docker.internal:11434/v1
# Ollama ignores the key, but one must be set.
OPENAI_API_KEY=ollama
# A 7B model on a laptop can take 10-30 s for a call.
LLM_TIMEOUT_SECONDS=120

SCRUBBER_LLM_MODEL=qwen2.5-coder:7b
CHAT_ROUTER_MODEL=qwen2.5-coder:7b
CHAT_EXTRACTION_MODEL=qwen2.5-coder:7b
LINKAGE_LLM_MODEL=qwen2.5-coder:7b
SKILL_SYNTHESIS_LLM_MODEL=qwen2.5-coder:7b
REDACTION_LLM_MODEL=qwen2.5-coder:7b
PR_CHECK_MODEL=qwen2.5-coder:7b
MEETING_EXTRACTION_LLM_MODEL=qwen2.5-coder:7b
# Meeting extractions are checked by the model above; batch needs OpenAI itself.
MEETING_JUDGE_MODE=direct
CI_FAILURE_EXTRACTION_LLM_MODEL=qwen2.5-coder:7b

EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_MODEL=mxbai-embed-large
# Must match the model's output width; `checkcord migrate` sizes the database column to it.
EMBEDDING_DIMENSION=1024

PUBLIC_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
# If 8000 or 3000 is taken, set these and change the two addresses above to match.
# CHECKCORD_API_PORT=8000
# CHECKCORD_WEB_PORT=3000
# CHECKCORD_POSTGRES_PORT=5432
# CHECKCORD_REDIS_PORT=6379
# Images Compose runs. Unset, it builds them here. To run a release instead, for example:
#   CHECKCORD_IMAGE=ghcr.io/mihirp381/checkcord:0.1.0
#   CHECKCORD_WEB_IMAGE=ghcr.io/mihirp381/checkcord/web:0.1.0
# CHECKCORD_IMAGE=checkcord:local
# CHECKCORD_WEB_IMAGE=checkcord-web:local
